<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>SSJJ.OfflineEntry</AssemblyName>
    <RootNamespace>SSJJ.OfflineEntry</RootNamespace>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>

    <!--
      路径占位符（在 VS / dotnet build 前自行替换或设置环境变量）：
        $(BepInExDir)   : 指向 BepInEx 5 的 core 目录，下面应有 BepInEx.Core.dll 与 0Harmony.dll
                           例：D:\SSJJ-4399\battle\3_64\BepInEx\core
        $(GameManaged)  : 指向游戏 Managed 目录
                           D:\SSJJ-4399\battle\3_64\SSJJ_BattleClient_Unity_Data\Managed
        $(DecryptedAsm) : 指向解密后的 Assembly-CSharp（已解密还原版）
                           D:\逆向\SSJJ双塔惊魂\Game source\01_metadata\recovered\Assembly-CSharp.decrypted.dll
      也可不改 csproj，而在构建时传参：
        dotnet build /p:BepInExDir=... /p:GameManaged=... /p:DecryptedAsm=...
    -->
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(MSBuildProjectDirectory)\..\..\..\SSJJ-4399\battle\3_64\BepInEx\core</BepInExDir>
    <GameManaged Condition="'$(GameManaged)' == ''">$(MSBuildProjectDirectory)\..\..\..\SSJJ-4399\battle\3_64\SSJJ_BattleClient_Unity_Data\Managed</GameManaged>
    <DecryptedAsm Condition="'$(DecryptedAsm)' == ''">$(MSBuildProjectDirectory)\..\..\Game source\01_metadata\recovered\Assembly-CSharp.decrypted.dll</DecryptedAsm>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx 5 (Mono) 运行时与 Harmony -->
    <Reference Include="BepInEx.Core">
      <HintPath>$(BepInExDir)\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- 游戏主逻辑（已解密还原版）。SSJJAsset_Library 在运行期由游戏加载，
         本插件通过反射访问 SSJJAsset.AssetBundle.AssetBundleManager，故此处不直接引用。 -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(DecryptedAsm)</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Unity 引擎程序集 -->
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
